{
  "name": "jewel-swap",
  "version": "0.1.0",
  "private": true,
  "description": "A calm colour-permutation puzzle dressed as diamond painting. Ad-free, offline-capable PWA.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jernejk/jewel-swap.git" },
  "homepage": "https://jewel-swap.vercel.app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npx vercel --prod --yes",
    "deploy:preview": "npx vercel --yes",
    "deploy:surge": "npm run build && npx surge dist",
    "art": "vite-node scripts/image-to-level.ts --"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
